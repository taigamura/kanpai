{
  "expo": {
    "name": "カンパイ！",
    "slug": "kanpai",
    "owner": "taigamura",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "scheme": "kanpai",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.kanpai.mvp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.kanpai.mvp",
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#233A63"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-6862698457969651~3900340220"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "広告の最適化のために使用します。トラッキングを許可しなくてもアプリはご利用いただけます。"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ea0d603a-8163-42b9-a1b4-0e93e41d95b5"
      }
    }
  }
}
